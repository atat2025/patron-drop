# Optional link back to the main site
NEXT_PUBLIC_HOME_URL=https://patron.red
# Vault network switch: testnet (Sei 1328, default) | mainnet (Sei 1329). Mainnet stays OFF until both are set.
NEXT_PUBLIC_VAULT_NETWORK=testnet
NEXT_PUBLIC_VAULT_ADDRESS=
NEXT_PUBLIC_VAULT_TOKEN=
# WalletConnect / Reown projectId (free at cloud.reown.com). Empty = injected wallets only + "Open in MetaMask" help sheet.
